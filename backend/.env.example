# =====================================================================
# Asan Global Backend — Environment Variables (example)
# Copy this file to `.env` in the backend folder and fill in your values.
# =====================================================================

# --- Supabase (existing) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Email (NEW) ---
# Master switch: "true" enables sending, "false" logs/skips (default false)
EMAIL_ENABLED=false

# Provider: "smtp" (real) or "log" (dev/testing, default).
# Swap later by adding providers/resend.js etc. without changing logic.
EMAIL_PROVIDER=log

# SMTP settings (only used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password

# "Sender Name <email>" shown as the From address
EMAIL_FROM=Asan Global <noreply@asanglobal.com>

# Comma-separated admin recipients for quote/message notifications.
# If empty, the backend falls back to querying profiles where role='admin'.
ADMIN_NOTIFY_EMAILS=admin@asanglobal.com,ops@asanglobal.com

# Base URL used for tracking links inside emails (e.g. the frontend)
APP_BASE_URL=http://localhost:5000
